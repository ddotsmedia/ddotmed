# ─────────────────────────────────────────────────────────────────────────────
# MediCore HMS — production environment
# Deployed to /etc/medicore/.env on the VPS (chmod 600, owner medicore).
# This template is committed; the filled-in file NEVER is.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Domain ───────────────────────────────────────────────────────────────────
# Set this once the domain is assigned, then run infrastructure/certbot-setup.sh
DOMAIN_PLACEHOLDER=
LETSENCRYPT_EMAIL=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=medicore
POSTGRES_PASSWORD=
POSTGRES_DB=medicore
DATABASE_URL=postgresql://medicore:CHANGE_ME@postgres:5432/medicore?schema=public

# ── Cache ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ── JWT (RS256) ──────────────────────────────────────────────────────────────
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# openssl rsa -pubout -in private.pem -out public.pem
# Store on one line with literal \n between lines.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=medicore
JWT_AUDIENCE=medicore-api
COOKIE_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://DOMAIN_PLACEHOLDER

# ── OAuth2 / OIDC ────────────────────────────────────────────────────────────
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://DOMAIN_PLACEHOLDER/auth/callback
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# ── SAML (leave false until XML signature verification is configured) ────────
SAML_ENABLED=false
SAML_SP_ENTITY_ID=urn:medicore:sp
SAML_ACS_URL=https://DOMAIN_PLACEHOLDER/api/auth/saml/acs
SAML_DEFAULT_TENANT=

# ── Messaging ────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092
KAFKA_ENABLED=true

# ── FHIR ─────────────────────────────────────────────────────────────────────
FHIR_SERVER_URL=http://hapi-fhir:8080/fhir
FHIR_SYNC_ENABLED=true
SMART_ISSUER=https://DOMAIN_PLACEHOLDER

# ── AI service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
AI_MODEL_GATEWAY=openai
AI_CONFIDENCE_THRESHOLD=0.70
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
WHISPER_MODEL=base
EMBEDDING_MODEL=text-embedding-3-small
MLFLOW_TRACKING_URI=

# ── Notifications ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Object storage ───────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=medicore

# ── National HIE adapters (leave blank until onboarded) ──────────────────────
MALAFFI_BASE_URL=
MALAFFI_CLIENT_ID=
MALAFFI_CLIENT_SECRET=
MALAFFI_FACILITY_ID=
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_CONSENT_ARTEFACT_ID=
NPHIES_BASE_URL=
NPHIES_CLIENT_ID=
NPHIES_CLIENT_SECRET=
NPHIES_PROVIDER_LICENSE=

# ── Tenant bootstrap ─────────────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=demo
DEFAULT_COUNTRY_PACK=uae

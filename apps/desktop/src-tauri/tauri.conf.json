{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediCore",
  "version": "1.0.0",
  "identifier": "ae.medicore.desktop",
  "build": {
    "frontendDist": "https://DOMAIN_PLACEHOLDER",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "MediCore HMS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://DOMAIN_PLACEHOLDER; script-src 'self' 'unsafe-inline' https://DOMAIN_PLACEHOLDER; style-src 'self' 'unsafe-inline' https://DOMAIN_PLACEHOLDER; img-src 'self' data: blob: https://DOMAIN_PLACEHOLDER; connect-src 'self' https://DOMAIN_PLACEHOLDER wss://DOMAIN_PLACEHOLDER",
      "capabilities": ["default"]
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "MediCore"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": [],
    "copyright": "MediCore",
    "category": "Medical",
    "shortDescription": "MediCore hospital workstation",
    "longDescription": "MediCore HMS desktop workstation with barcode scanning, label printing, document scanning, smart card reading and offline sync."
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": ["https://DOMAIN_PLACEHOLDER/updates/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}

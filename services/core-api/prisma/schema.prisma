  reorder_level     Int       @default(0)
  reorder_quantity  Int       @default(0)
  unit              String
  cost_price_minor  Int       @default(0)
  sale_price_minor  Int       @default(0)
  currency          String    @db.VarChar(3)
  gtin              String?

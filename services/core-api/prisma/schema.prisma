// MediCore HMS — complete schema.
// Conventions applied to every table:
//   id          UUID v7 primary key (time-ordered, index-friendly)
//   tenant_id   UUID tenant scope, enforced by TenantInterceptor on every query
//   fhir_id     UUID unique, present on every clinically-shareable table
//   created_at / updated_at / deleted_at / deleted_reason  — soft delete only, PHI is never hard-deleted

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── enums ───────────────────────────

enum Gender {
  male
  female
  other
  unknown
}

enum EncounterStatus {
  planned
  arrived
  triaged
  in_progress
  onleave
  finished
  cancelled
  closed
}

enum EncounterClass {
  AMB
  EMER
  IMP
  ACUTE
  NONAC
  OBSENC
  VR
  HH
}

enum AppointmentStatus {
  proposed
  pending
  booked
  arrived
  fulfilled
  cancelled
  noshow
  checked_in
  waitlist
  /// Unscheduled arrival: no slot, queue token instead of a start time.
  walk_in
}

enum ConditionCategory {
  problem_list_item
  encounter_diagnosis
}

enum ClinicalStatus {
  active
  recurrence
  relapse
  inactive
  remission
  resolved
}

enum VerificationStatus {
  unconfirmed
  provisional
  differential
  confirmed
  refuted
  entered_in_error
}

enum AllergyCriticality {
  low
  high
  unable_to_assess
}

enum AllergyCategory {
  food
  medication
  environment
  biologic
  latex
  contrast
}

enum MedicationStatus {
  draft
  active
  on_hold
  cancelled
  completed
  stopped
}

enum NoteType {
  soap
  progress
  nursing
  discharge
  sbar
}

enum NoteStatus {
  draft
  pending_approval
  signed
  amended
  entered_in_error
}

enum ObservationStatus {
  registered
  preliminary
  final
  amended
  corrected
  cancelled
}

enum RequestStatus {
  draft
  active
  on_hold
  revoked
  completed
  entered_in_error
}

enum BedStatus {
  available
  occupied
  reserved
  cleaning
  blocked
  maintenance
}

enum BedType {
  general
  icu
  hdu
  isolation
  nicu
  picu
  ot
  er
  maternity
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
  written_off
}

enum ClaimStatus {
  draft
  pre_auth_required
  pre_auth_approved
  pre_auth_denied
  submitted
  accepted
  rejected
  partially_paid
  paid
  denied
  appealed
  closed
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  insurance
  wallet
  apple_pay
  google_pay
  cheque
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

enum AuditOutcome {
  success
  failure
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum AiProvider {
  azure_openai
  openai
  anthropic
  google
  local
}

// ─────────────────────── tenancy & identity ───────────────────────

model Tenant {
  id             String    @id @default(uuid(7)) @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  slug           String    @unique
  name           String
  country_pack   String
  default_locale String    @default("en")
  timezone       String    @default("UTC")
  currency       String    @db.VarChar(3)
  active_modules String[]  @default([])
  settings       Json      @default("{}")
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  users         User[]
  roles         Role[]
  organizations Organization[]
  patients      Patient[]

  @@index([slug])
  @@map("tenants")
}

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  tenant_id             String    @db.Uuid
  fhir_id               String?   @unique @db.Uuid
  email                 String
  phone                 String?
  password_hash         String?
  is_active             Boolean   @default(true)
  email_verified_at     DateTime? @db.Timestamptz(6)
  mfa_enabled           Boolean   @default(false)
  mfa_secret            String?
  mfa_recovery_codes    String[]  @default([])
  oidc_subject          String?
  oidc_issuer           String?
  saml_name_id          String?
  // Set only on patient-portal accounts; scopes every portal read to this record.
  patient_id            String?   @unique @db.Uuid
  failed_login_attempts Int       @default(0)
  locked_until          DateTime? @db.Timestamptz(6)
  last_login_at         DateTime? @db.Timestamptz(6)
  password_changed_at   DateTime? @db.Timestamptz(6)
  preferred_locale      String    @default("en")
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at            DateTime? @db.Timestamptz(6)
  deleted_reason        String?

  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  patient      Patient?      @relation("PatientPortalAccount", fields: [patient_id], references: [id])
  user_roles   UserRole[]
  sessions     Session[]
  audit_logs   AuditLog[]
  practitioner Practitioner?
  staff_profile StaffProfile?

  @@unique([tenant_id, email])
  @@index([tenant_id, is_active])
  @@index([oidc_subject])
  @@map("users")
}

model Role {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  key            String
  name           String
  description    String?
  is_system      Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  tenant           Tenant           @relation(fields: [tenant_id], references: [id])
  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@unique([tenant_id, key])
  @@map("roles")
}

model Permission {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String?   @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  key            String    @unique
  description    String?
  category       String
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenant_id     String   @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  user_id        String    @db.Uuid
  role_id        String    @db.Uuid
  location_id    String?   @db.Uuid
  granted_by     String?   @db.Uuid
  expires_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, location_id])
  @@index([tenant_id, user_id])
  @@map("user_roles")
}

model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenant_id         String    @db.Uuid
  user_id           String    @db.Uuid
  refresh_token_jti String    @unique
  refresh_expires_at DateTime @db.Timestamptz(6)
  ip                String?
  user_agent        String?
  device_id         String?
  mfa_verified      Boolean   @default(false)
  is_break_glass    Boolean   @default(false)
  last_activity_at  DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at        DateTime? @db.Timestamptz(6)
  revoked_reason    String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_reason    String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, user_id, revoked_at])
  @@index([refresh_expires_at])
  @@map("sessions")
}

model AuditLog {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenant_id      String       @db.Uuid
  fhir_id        String?      @unique @db.Uuid
  user_id        String?      @db.Uuid
  session_id     String?      @db.Uuid
  action         String
  resource_type  String
  resource_id    String?      @db.Uuid
  patient_id     String?      @db.Uuid
  outcome        AuditOutcome @default(success)
  is_break_glass Boolean      @default(false)
  break_glass_reason String?
  ip             String?
  user_agent     String?
  before_state   Json?
  after_state    Json?
  occurred_at    DateTime     @default(now()) @db.Timestamptz(6)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?    @db.Timestamptz(6)
  deleted_reason String?

  user User? @relation(fields: [user_id], references: [id])

  @@index([tenant_id, occurred_at])
  @@index([tenant_id, patient_id, occurred_at])
  @@index([tenant_id, user_id, occurred_at])
  @@index([tenant_id, is_break_glass])
  @@map("audit_logs")
}

// ─────────────────────── org structure ───────────────────────

model Organization {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenant_id       String    @db.Uuid
  fhir_id         String?   @unique @db.Uuid
  parent_id       String?   @db.Uuid
  name            String
  type            String
  license_number  String?
  country         String    @db.VarChar(2)
  address         Json?
  telecom         Json      @default("[]")
  tax_registration_number String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  deleted_reason  String?

  tenant    Tenant         @relation(fields: [tenant_id], references: [id])
  parent    Organization?  @relation("OrgTree", fields: [parent_id], references: [id])
  children  Organization[] @relation("OrgTree")
  locations Location[]

  @@index([tenant_id, type])
  @@map("organizations")
}

model Location {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenant_id       String    @db.Uuid
  fhir_id         String?   @unique @db.Uuid
  organization_id String    @db.Uuid
  name            String
  type            String
  floor           String?
  building        String?
  address         Json?
  operational_status String @default("active")
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  deleted_reason  String?

  organization Organization @relation(fields: [organization_id], references: [id])
  beds         Bed[]
  encounters   Encounter[]
  appointments Appointment[]

  @@index([tenant_id, organization_id])
  @@map("locations")
}

model Practitioner {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenant_id          String    @db.Uuid
  fhir_id            String?   @unique @db.Uuid
  user_id            String?   @unique @db.Uuid
  given_names        String[]
  family_name        String
  gender             Gender?
  license_number     String
  license_authority  String
  license_expires_at DateTime? @db.Timestamptz(6)
  npi                String?
  specialties        String[]  @default([])
  qualifications     String[]  @default([])
  telecom            Json      @default("[]")
  signature_url      String?
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_reason     String?

  user               User?               @relation(fields: [user_id], references: [id])
  practitioner_roles PractitionerRole[]
  encounters         Encounter[]
  appointments       Appointment[]
  medications        Medication[]
  schedules          Schedule[]

  @@unique([tenant_id, license_number])
  @@index([tenant_id, is_active])
  @@map("practitioners")
}

model PractitionerRole {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenant_id       String    @db.Uuid
  fhir_id         String?   @unique @db.Uuid
  practitioner_id String    @db.Uuid
  organization_id String?   @db.Uuid
  location_id     String?   @db.Uuid
  code            String
  specialty       String?
  available_time  Json      @default("[]")
  period_start    DateTime? @db.Timestamptz(6)
  period_end      DateTime? @db.Timestamptz(6)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  deleted_reason  String?

  practitioner Practitioner @relation(fields: [practitioner_id], references: [id])

  @@index([tenant_id, practitioner_id])
  @@map("practitioner_roles")
}

// ─────────────────────── patient ───────────────────────

model Patient {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenant_id          String    @db.Uuid
  fhir_id            String?   @unique @db.Uuid
  mrn                String
  given_names        String[]
  family_name        String
  name_search        String
  gender             Gender
  birth_date         DateTime  @db.Date
  deceased_at        DateTime? @db.Timestamptz(6)
  marital_status     String?
  preferred_language String    @default("en")
  nationality        String?   @db.VarChar(2)
  blood_group        String?
  address            Json?
  photo_url          String?
  is_vip             Boolean   @default(false)
  merged_into_id     String?   @db.Uuid
  merged_at          DateTime? @db.Timestamptz(6)
  merged_by          String?   @db.Uuid
  country_pack       String
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_reason     String?

  tenant        Tenant              @relation(fields: [tenant_id], references: [id])
  merged_into   Patient?            @relation("PatientMerge", fields: [merged_into_id], references: [id])
  merged_from   Patient[]           @relation("PatientMerge")
  identifiers   PatientIdentifier[]
  contacts      PatientContact[]
  encounters    Encounter[]
  appointments  Appointment[]
  conditions    Condition[]
  allergies     Allergy[]
  vitals        Vital[]
  medications   Medication[]
  clinical_notes ClinicalNote[]
  care_plans    CarePlan[]
  service_requests ServiceRequest[]
  lab_results   LabResult[]
  lab_specimens LabSpecimen[]
  imaging_studies ImagingStudy[]
  invoices      Invoice[]
  payments      Payment[]
  coverages     Coverage[]
  claims        InsuranceClaim[]
  admissions    Admission[]
  ai_sessions   AiSession[]
  medication_dispenses MedicationDispense[]
  medication_administrations MedicationAdministration[]
  pre_authorizations PreAuthorization[]
  portal_account User? @relation("PatientPortalAccount")
  relationships_from PatientRelationship[] @relation("RelationshipFrom")
  relationships_to   PatientRelationship[] @relation("RelationshipTo")

  @@unique([tenant_id, mrn])
  @@index([tenant_id, family_name, birth_date])
  @@index([tenant_id, name_search])
  @@index([tenant_id, deleted_at])
  @@map("patients")
}

model PatientIdentifier {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  patient_id     String    @db.Uuid
  type           String
  value          String
  value_normalized String
  system         String?
  country        String?   @db.VarChar(2)
  is_primary     Boolean   @default(false)
  expires_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, type, value_normalized])
  @@index([tenant_id, patient_id])
  @@index([tenant_id, value_normalized])
  @@map("patient_identifiers")
}

/// Family / household links between patients. Directional rows: creating
/// "A is mother of B" also writes the inverse "B is child of A", so either
/// patient's chart shows the relationship without a union query.
model PatientRelationship {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  patient_id     String    @db.Uuid
  related_patient_id String @db.Uuid
  relationship   String
  /// Set on the row that was entered by a user; the generated inverse is false.
  is_primary_record Boolean @default(true)
  /// Genetically relevant links drive family-history prompts in the EHR.
  is_biological  Boolean   @default(false)
  is_emergency_contact Boolean @default(false)
  is_guarantor   Boolean   @default(false)
  notes          String?
  recorded_by    String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  patient         Patient @relation("RelationshipFrom", fields: [patient_id], references: [id], onDelete: Cascade)
  related_patient Patient @relation("RelationshipTo", fields: [related_patient_id], references: [id], onDelete: Cascade)

  @@unique([patient_id, related_patient_id, relationship])
  @@index([tenant_id, patient_id])
  @@index([tenant_id, related_patient_id])
  @@map("patient_relationships")
}

model PatientContact {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  patient_id     String    @db.Uuid
  relationship   String
  given_names    String[]  @default([])
  family_name    String?
  system         String
  value          String
  use            String    @default("mobile")
  is_emergency   Boolean   @default(false)
  is_primary     Boolean   @default(false)
  rank           Int?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, patient_id])
  @@index([tenant_id, value])
  @@map("patient_contacts")
}

// ─────────────────────── scheduling ───────────────────────

model Schedule {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenant_id       String    @db.Uuid
  fhir_id         String?   @unique @db.Uuid
  practitioner_id String?   @db.Uuid
  location_id     String?   @db.Uuid
  service_type    String
  specialty       String?
  planning_start  DateTime  @db.Timestamptz(6)
  planning_end    DateTime  @db.Timestamptz(6)
  slot_minutes    Int       @default(15)
  recurrence      Json      @default("{}")
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  deleted_reason  String?

  practitioner Practitioner? @relation(fields: [practitioner_id], references: [id])
  slots        Slot[]

  @@index([tenant_id, practitioner_id, planning_start])
  @@index([tenant_id, practitioner_id, is_active])
  @@map("schedules")
}

model Slot {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  schedule_id    String    @db.Uuid
  start          DateTime  @db.Timestamptz(6)
  end            DateTime  @db.Timestamptz(6)
  status         String    @default("free")
  overbooked     Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  schedule     Schedule      @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([schedule_id, start])
  @@index([tenant_id, start, status])
  @@index([schedule_id, status, start])
  @@map("slots")
}

model Appointment {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenant_id         String            @db.Uuid
  fhir_id           String?           @unique @db.Uuid
  patient_id        String            @db.Uuid
  practitioner_id   String?           @db.Uuid
  location_id       String?           @db.Uuid
  slot_id           String?           @db.Uuid
  status            AppointmentStatus @default(booked)
  service_type      String
  specialty         String?
  start             DateTime          @db.Timestamptz(6)
  end               DateTime          @db.Timestamptz(6)
  minutes_duration  Int
  reason_text       String?
  channel           String            @default("walk-in")
  is_telehealth     Boolean           @default(false)
  telehealth_url    String?
  queue_token       String?
  noshow_risk       Decimal?          @db.Decimal(4, 3)
  reminder_sent_at  DateTime?         @db.Timestamptz(6)
  reminder_channel  String?
  checked_in_at     DateTime?         @db.Timestamptz(6)
  cancellation_reason String?
  created_by        String?           @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)
  deleted_reason    String?

  patient      Patient       @relation(fields: [patient_id], references: [id])
  practitioner Practitioner? @relation(fields: [practitioner_id], references: [id])
  location     Location?     @relation(fields: [location_id], references: [id])
  slot         Slot?         @relation(fields: [slot_id], references: [id])
  encounters   Encounter[]
  queue_entries Queue[]

  @@index([tenant_id, start, status])
  @@index([tenant_id, patient_id, start])

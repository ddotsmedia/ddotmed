  biometric_id      String?
  contracted_hours_per_week Int @default(40)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_reason    String?

  user        User           @relation(fields: [user_id], references: [id])
  reports_to  StaffProfile?  @relation("Reports", fields: [reports_to_id], references: [id])
  reportees   StaffProfile[] @relation("Reports")
  schedules   StaffSchedule[]
  credentials Credential[]

  @@unique([tenant_id, employee_number])
  @@index([tenant_id, department])
  @@map("staff_profiles")
}

model Shift {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  fhir_id        String?   @unique @db.Uuid
  name           String
  code           String
  start_time     String
  end_time       String
  break_minutes  Int       @default(30)
  is_night_shift Boolean   @default(false)
  min_nurses     Int       @default(0)
  min_doctors    Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  schedules StaffSchedule[]

  @@unique([tenant_id, code])
  @@map("shifts")
}

model StaffSchedule {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenant_id         String    @db.Uuid
  fhir_id           String?   @unique @db.Uuid
  staff_profile_id  String    @db.Uuid
  shift_id          String    @db.Uuid
  location_id       String?   @db.Uuid
  ward              String?
  shift_date        DateTime  @db.Date
  status            String    @default("scheduled")
  clock_in_at       DateTime? @db.Timestamptz(6)
  clock_out_at      DateTime? @db.Timestamptz(6)
  clock_in_method   String?
  assigned_patients Int       @default(0)
  swap_requested_with_id String? @db.Uuid
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_reason    String?

  staff_profile StaffProfile @relation(fields: [staff_profile_id], references: [id])
  shift         Shift        @relation(fields: [shift_id], references: [id])

  @@unique([staff_profile_id, shift_date, shift_id])
  @@index([tenant_id, shift_date, ward])
  @@map("staff_schedules")
}

model Credential {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenant_id         String    @db.Uuid
  fhir_id           String?   @unique @db.Uuid
  staff_profile_id  String    @db.Uuid
  type              String
  name              String
  identifier        String
  issuing_authority String
  issued_at         DateTime  @db.Date
  expires_at        DateTime? @db.Date
  document_url      String?
  status            String    @default("valid")
  last_alert_sent_at DateTime? @db.Timestamptz(6)
  verified_by       String?   @db.Uuid
  verified_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_reason    String?

  staff_profile StaffProfile @relation(fields: [staff_profile_id], references: [id])

  // Credential-expiry sweep runs against this index nightly.
  @@index([tenant_id, expires_at, status])
  @@map("credentials")
}

// ─────────────────────── AI governance ───────────────────────

model AiSession {
  id                String     @id @default(uuid(7)) @db.Uuid
  tenant_id         String     @db.Uuid
  fhir_id           String?    @unique @db.Uuid
  patient_id        String?    @db.Uuid
  encounter_id      String?    @db.Uuid
  user_id           String     @db.Uuid
  session_type      String
  provider          AiProvider
  model_version     String
  status            String     @default("active")
  audio_duration_ms Int?
  audio_storage_key String?
  transcript        String?
  language          String     @default("en")
  consent_obtained  Boolean    @default(false)
  started_at        DateTime   @default(now()) @db.Timestamptz(6)
  ended_at          DateTime?  @db.Timestamptz(6)
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime   @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?  @db.Timestamptz(6)
  deleted_reason    String?

  patient   Patient?    @relation(fields: [patient_id], references: [id])
  encounter Encounter?  @relation(fields: [encounter_id], references: [id])
  drafts    AiDraft[]
  audit_logs AiAuditLog[]

  @@index([tenant_id, user_id, started_at])
  @@index([tenant_id, patient_id])
  @@map("ai_sessions")
}

model AiAuditLog {
  id               String     @id @default(uuid(7)) @db.Uuid
  tenant_id        String     @db.Uuid
  fhir_id          String?    @unique @db.Uuid
  ai_session_id    String?    @db.Uuid
  user_id          String?    @db.Uuid
  patient_id       String?    @db.Uuid
  operation        String
  provider         AiProvider
  model_version    String
  prompt_tokens    Int        @default(0)
  completion_tokens Int       @default(0)
  latency_ms       Int        @default(0)
  confidence_score Decimal?   @db.Decimal(4, 3)
  low_confidence   Boolean    @default(false)
  // Prompts and completions are hashed, not stored, unless retention is explicitly enabled.
  prompt_hash      String?
  response_hash    String?
  prompt_redacted  String?
  error            String?
  cost_minor       Int        @default(0)
  occurred_at      DateTime   @default(now()) @db.Timestamptz(6)
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?  @db.Timestamptz(6)
  deleted_reason   String?

  ai_session AiSession? @relation(fields: [ai_session_id], references: [id])

  @@index([tenant_id, occurred_at])
  @@index([tenant_id, operation, low_confidence])
  @@map("ai_audit_logs")
}

model AiDraft {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenant_id        String    @db.Uuid
  fhir_id          String?   @unique @db.Uuid
  ai_session_id    String    @db.Uuid
  patient_id       String?   @db.Uuid
  encounter_id     String?   @db.Uuid
  draft_type       String
  content          Json
  linked_evidence  Json      @default("[]")
  suggested_codes  Json      @default("[]")
  confidence_score Decimal?  @db.Decimal(4, 3)
  model_version    String
  // Nothing AI-authored enters the record without a clinician acting on it.
  requires_approval Boolean  @default(true)
  status           String    @default("pending")
  reviewed_by      String?   @db.Uuid
  reviewed_at      DateTime? @db.Timestamptz(6)
  edit_distance    Int?
  applied_to_type  String?
  applied_to_id    String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)
  deleted_reason   String?

  ai_session AiSession @relation(fields: [ai_session_id], references: [id])

  @@index([tenant_id, status, created_at])
  @@index([tenant_id, encounter_id])
  @@map("ai_drafts")
}

/// In-app notification inbox.
///
/// Separate from the Kafka alert streams: those fan out and are gone, this is the
/// durable record that a named clinician was told something and either did or did
/// not acknowledge it. A critical lab value that nobody acknowledged has to still
/// be visible tomorrow.
model Notification {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenant_id     String    @db.Uuid
  /// Recipient. A role fan-out when no single user owns the alert.
  user_id       String?   @db.Uuid
  role          String?
  category      String
  severity      String    @default("info")
  title         String
  body          String
  patient_id    String?   @db.Uuid
  encounter_id  String?   @db.Uuid
  resource_type String?
  resource_id   String?   @db.Uuid
  /// Collapses repeat alerts for the same clinical fact.
  dedupe_key    String?
  requires_acknowledgement Boolean @default(false)
  acknowledged_at DateTime? @db.Timestamptz(6)
  acknowledged_by String?  @db.Uuid
  read_at       DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_reason String?

  @@unique([tenant_id, dedupe_key])
  @@index([tenant_id, user_id, acknowledged_at])
  @@index([tenant_id, role, acknowledged_at])
  @@index([tenant_id, category, created_at])
  @@map("notifications")
}

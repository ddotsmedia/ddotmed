# ── copy to .env for local development; never commit a filled-in copy ──
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://medicore:medicore_dev@localhost:5432/medicore?schema=public
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_dev
POSTGRES_DB=medicore

# Cache / sessions
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT — RS256. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Newlines must be escaped as \n when stored on one line.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=medicore
JWT_AUDIENCE=medicore-api
COOKIE_SECRET=change-me-in-production

# OAuth2 / OIDC
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# SAML — leave false until XML signature verification is configured
SAML_ENABLED=false
SAML_SP_ENTITY_ID=urn:medicore:sp
SAML_ACS_URL=http://localhost:4000/api/auth/saml/acs
SAML_DEFAULT_TENANT=

# CORS — explicit allow-list, comma separated
CORS_ORIGINS=http://localhost:3000

# Messaging
KAFKA_BROKERS=localhost:9092
KAFKA_ENABLED=true

# FHIR
FHIR_SERVER_URL=http://localhost:8080/fhir

# AI service
AI_SERVICE_URL=http://localhost:8000
# Where a browser opens the scribe audio socket; defaults to AI_SERVICE_URL.
AI_SERVICE_PUBLIC_URL=http://localhost:8000
ANTHROPIC_MODEL=claude-haiku-4-5
AI_MODEL_GATEWAY=anthropic
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.70

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=medicore
MINIO_SECRET_KEY=medicore_dev_secret
MINIO_BUCKET=medicore

# Default tenant bootstrap
DEFAULT_TENANT_SLUG=demo
DEFAULT_COUNTRY_PACK=uae
